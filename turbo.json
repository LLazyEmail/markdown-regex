{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "inputs": [
        "src/**",
        "packages/*/src/**",
        "tsup.config.ts",
        "tsconfig.json",
        "package.json"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "outputs": [],
      "inputs": [
        "src/**",
        "packages/*/src/**",
        "tests/**",
        "vitest.config.ts",
        "package.json"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "inputs": [
        "src/**",
        "packages/*/src/**",
        "tsconfig.json",
        "packages/*/tsconfig.json"
      ]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "src/**",
        "packages/*/src/**",
        "tests/**",
        "eslint.config.js"
      ]
    },
    "test:fixtures": {
      "dependsOn": [
        "build"
      ],
      "outputs": [],
      "inputs": [
        "fixtures/real-world/**",
        "tests/real-world-fixtures.test.ts",
        "vitest.fixtures.config.ts",
        "packages/*/src/**",
        "src/**",
        "package.json"
      ]
    }
  }
}
