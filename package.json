{
  "name": "markdown-regex",
  "version": "2.1.1",
  "description": "Zero-dependency, TypeScript-typed RegExp patterns for extracting headers, links, images, lists and code from Markdown; ideal for scripts and AI-agent tools",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.global.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./cleanup": {
      "types": "./dist/cleanup.d.ts",
      "import": "./dist/cleanup.js",
      "require": "./dist/cleanup.cjs",
      "default": "./dist/cleanup.js"
    },
    "./frontmatter": {
      "types": "./dist/frontmatter.d.ts",
      "import": "./dist/frontmatter.js",
      "require": "./dist/frontmatter.cjs",
      "default": "./dist/frontmatter.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.js",
      "require": "./dist/blocks.cjs",
      "default": "./dist/blocks.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "import": "./dist/email.js",
      "require": "./dist/email.cjs",
      "default": "./dist/email.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt",
    "AGENTS.md",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npx tsup && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/cli.js', 0o755);\"",
    "dev": "npx tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev1": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src packages tests",
    "prepublishOnly": "pnpm exec turbo run build test && pnpm run typecheck",
    "clean": "rm -rf dist coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "turbo:build": "turbo run build",
    "turbo:test": "turbo run test",
    "turbo:lint": "turbo run lint",
    "turbo:typecheck": "turbo run typecheck",
    "coverage:core": "vitest run --coverage --coverage.include=packages/core/src/**/*.ts --coverage.exclude=packages/core/src/**/*.js",
    "ci:affected": "turbo run lint typecheck build test --filter=...[origin/main]",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@markdown-regex/blocks": "workspace:^",
    "@markdown-regex/core": "workspace:^",
    "@markdown-regex/email": "workspace:^",
    "@markdown-regex/frontmatter": "workspace:^",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "glob": "^14.0.0",
    "globals": "^17.14.0",
    "tsup": "^9.0.0",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LLazyEmail/markdown-regex.git"
  },
  "bugs": {
    "url": "https://github.com/LLazyEmail/markdown-regex/issues"
  },
  "homepage": "https://github.com/LLazyEmail/markdown-regex#readme",
  "author": "Arthur Tkachenko",
  "license": "MIT",
  "keywords": [
    "markdown",
    "markdown-parser",
    "regex",
    "regexp",
    "typescript",
    "zero-dependency",
    "commonmark",
    "parser",
    "extract",
    "headers",
    "links",
    "images",
    "lists",
    "markdown-links",
    "markdown-images",
    "markdown-headers",
    "extract-links",
    "ai-agents",
    "llms",
    "regexp-patterns",
    "tree-shaking",
    "esm",
    "cjs"
  ],
  "bin": {
    "markdown-regex": "./dist/cli.js"
  },
  "packageManager": "pnpm@9.15.9"
}
