{
  "name": "@markdown-regex/blocks",
  "version": "2.2.0",
  "description": "Flat :::name custom blocks for markdown-regex (private workspace package)",
  "type": "module",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --no-config --format esm,cjs --dts --clean --target node20 --platform node",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --no-warn-ignored"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Arthur Tkachenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLazyEmail/markdown-regex.git",
    "directory": "packages/blocks"
  }
}
